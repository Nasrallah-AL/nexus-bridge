{
  "name": "nexus-bridge-proxy",
  "version": "1.1.7",
  "description": "Nexus Bridge is an HTTP API wrapper for Claude CLI with sessions, async tasks, streaming, load balancing, and a TUI management tool",
  "main": "server.js",
  "bin": {
    "nexus-bridge-proxy": "./cli.js"
  },
  "scripts": {
    "start": "node server.js",
    "cli": "node cli.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "files": [
    "cli.js",
    "server.js",
    "swagger-config.js",
    "src/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "claude",
    "claude-cli",
    "claude-code",
    "nexus-bridge",
    "claude-code-api",
    "claude-code-api-server"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/csdwd/nexus-bridge.git"
  },
  "homepage": "https://github.com/csdwd/nexus-bridge#readme",
  "bugs": {
    "url": "https://github.com/csdwd/nexus-bridge/issues"
  },
  "author": "csdwd",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "blessed": "^0.1.81",
    "chalk": "^4.1.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "inquirer": "^8.2.6",
    "joi": "^18.0.2",
    "lowdb": "^4.0.1",
    "node-cron": "^4.2.1",
    "ora": "^5.4.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
